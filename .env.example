# Optional for shared RSVP storage. Without these values, responses are saved only in this browser.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to an ISO date/time to automatically show an expired invitation screen after that time.
# Example: 2026-11-16T23:59:00+07:00
VITE_INVITATION_EXPIRES_AT=
